[Unit]
Description=Ly odometry hardware PTP grandmaster on %i
Requires=ly-ptp-bootstrap@%i.service
After=ly-ptp-bootstrap@%i.service

[Service]
Type=simple
ExecStart=/usr/sbin/ptp4l -f /etc/linuxptp/ly-odom/master-%i.conf -i %i -m
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
